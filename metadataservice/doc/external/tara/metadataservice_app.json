    "interfaces": {
        "technology.cariad.entertainment.metadataserviceclient.api.IMetadataServiceAid (1)": {
            "technology": "Android Service Consumption",
            "dataSanityIsGuaranteedFromSender": false,
            "dataSanityIsCheckedAtReceiver": true,
            "sourceAuthenticatedBy": "ANDROID_SYSTEM",
            "services": [
                "technology.cariad.entertainment.metadataservice.service.MetadataService"
            ],
            "serviceProtocol": "AIDL",
            "customAttributes": [
                "can request:",
                "- data textual radio -> ConnectedRadio",
                "- textual for media -> Gracenote Backend",
                "- based on audio signal currently playing -> Android (media, radio) system get audio schnipsel",
                "metadata for radio stations, songs, coverart"
            ],
            "assets": {
                "GDPR": "metadata for radio stations, songs",
                "INT": "metadata for radio stations, songs, coverart"
            },
            "src": "Client(s)",
            "dst": "MetadataService"
        },
        "technology.cariad.entertainment.metadataserviceclient.api.IMetadataServiceAid (2)": {
            "technology": "Android Service Provision",
