                "technology.cariad.entertainment.metadataservice.service.MetadataService"
            ],
            "serviceProtocol": "AIDL",
            "customAttributes": [
                "protected by technology.cariad.entertainment.metadataservice.USE_SERVICE",
                "protection: signature/privileged",
                "provide: text metadata",
                "provide: lyrics",
                "provide: URL for radio stations, getting from conradlib",
                "request"
            ],
            "assets": {
                "INT": "request"
            },
            "src": "MetadataService",
            "dst": "Client(s)"
        },
