    "components": {
        "MetadataService": {
            "componentType": "Own_Service",
            "securityClassification": "medium",
            "vm": "IVI",
            "modules": [
                "perforce-swarm.eso.local:8443/files/oi/metadataservice/metadataservice_app",
                "perforce-swarm.eso.local:8443/files/oi/metadataservice/metadataservice_app/metadataservice",
                "perforce-swarm.eso.local:8443/files/oi/metadataservice/metadataservice_app/gracenoteservice"
            ],
            "apks": [
                "MetadataService-prod-arm64-v8a-release-unsigned.apk"
            ],
            "customAttributes": [
                "provides Radio and Music metadata",
                "Low Secutity and Safety, but contractually it could potentially cause financial harm",
                "gracenote certificate is stored in the apk",
                "gracenote_sdk also SWE but delivered from Gracenote"
            ]
        },
        "MetadataServiceDEMO": {
            "componentType": "Own_Service",
            "vm": "IVI",
            "apks": [
                "MetadataService-prod-arm64-v8a-release-unsigned.apk"
            ],
            "debug": {
                "condition": "DEV only",
                "testcase": "https://polarion-hcp3.eso.local/polarion/redirect/project/OI_Global_CLU51/workitem?id=OIG-65236"
            },
            "securityClassification": "medium",
            "customAttributes": [
                "used for testing and demonstration"
            ]
        },
        "NetworkManager": {
            "componentType": "Service",
            "securityClassification": "low",
            "vm": "UNKNOWN",
            "customAttributes": [
                "located in ConMod"
            ]
        },
        "Client(s)": {
            "componentType": "Application",
            "securityClassification": "medium",
            "vm": "IVI",
            "customAttributes": [
                "They have to handle the licensed data and should reasonably securely handle it",
                "Low Secutity and Safety, but contractually it could potentially cause financial harm",
                "Provides: HCPG-64 - metadataservice_clientinterface (as client libraries/SDK)",
                "current radio(eso) and media(harman), erlebnis innenraum (audi)"
            ]
        },
        "metadataservice-data": {
            "shared": true,
            "componentType": "File_System",
            "storesCredentials": false,
            "signed": false,
            "removableStorage": false,
            "storesLogData": false,
            "encrypted": true,
            "reasonOos": "informational purpose of getting files provider",
            "vm": "IVI",
            "writeAccess": true,
            "OutOfScope": true,
            "customAttributes": [
                "stored in the ESM",
                "stores big files in order to share them with the clients via descriptors (FileProvider API)",
                "Shared to a limited audience, only clients explicitly allowed to access certain files",
                "stores a database containing the local config (e. g. connection handling behavior, text based, no authentication data ...)",
                "Clients get read only permissions",
                "actual path -> path provided by lib from harman",
                "stores data in /data/vendor/extended-storage/metadataservice-data/** -> encrypted by standard Android filesystem encryption"
            ]
        },
        "gracenote-sdk": {
            "componentType": "Service",
            "securityClassification": "medium",
            "vm": "IVI",
            "customAttributes": [
                "licensing done by CARIAD",
                "actually lib that handles the communication to the gracenote backend",
                "sdk provided by CARIAD"
            ]
        },
        "Gracenote Backend": {
            "componentType": "Service",
            "vm": "OUTSIDE_OF_UNIT",
            "OutOfScope": true,
            "reasonOos": "communication is handled by gracenote sdk, not esolutions component"
        },
        "MagicAdapter": {
            "componentType": "Service",
            "securityClassification": "medium",
            "vm": "IVI",
            "customAttributes": [
                "provided Service: ServicelistAPI; DisabledReasonAPI"
            ]
        },
        "/product/priv-app/": {
            "shared": false,
            "componentType": "File_System",
            "storesCredentials": false,
            "signed": true,
            "removableStorage": false,
            "storesLogData": false,
            "encrypted": false,
            "vm": "IVI",
            "writeAccess": false,
            "customAttributes": [
                "installed place",
                "protected by secure boot"
            ]
        },
        "Android System": {
            "componentType": "Android_System",
            "vm": "IVI",
            "customAttributes": [
                "AndroidService",
                "provides login OAuth2 token for ConRad Backend",
                "handled by metadataservice_conradlib"
            ]
        },
        "media, radio": {
            "componentType": "Android_System",
            "vm": "IVI"
        },
        "Navi": {
            "componentType": "Service",
            "securityClassification": "medium",
            "vm": "IVI",
            "customAttributes": [
                "used to retrieve position of car"
            ]
        },
        "metadataservice_conradlib": {
            "componentType": "Service",
            "securityClassification": "high",
            "vm": "IVI",
            "customAttributes": [
                "lib included in and used solely by Metadata Service (Media)",
                "communicates with ConnectedRadio_Backend"
            ]
        },
        "metadataservice_gmdlib": {
            "componentType": "Service",
            "securityClassification": "medium",
            "vm": "IVI",
            "customAttributes": [
                "lib included in and used solely by Metadata Service (Media)",
                "communicates with GMD Backend"
            ]
        },
        "android_VHAL": {
            "componentType": "Android_System",
            "vm": "IVI",
            "customAttributes": [
                "abstraction for vehicle properties"
            ]
        }
    }
