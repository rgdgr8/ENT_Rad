@startuml
title Get full data from the backend

participant "metadataservice_app" as media
participant "metadataservice_conradlib" as crc
participant "ConnectedRadio_Backend" as crb

media -> crc : getRadioStationData(IBearer, ETags, RadioStationDataCallback)
crc -> crc : getRadioStationData(MediaRequestObject)
crc -> crc : create new container or add to container
crc -> crc : wait for other bearer requests
crc -> crc : Check valid registration
crc -> crb : request bearers as json
activate crb
crc <- crb : receive data as json
deactivate crb
crc -> crc : parseJson
media <- crc : onMetadata(ETag-String, StationMetadata)
media <- crc : onStreams(ETag-String List<WebStream>)
media <- crc : onBearers(ETag-String, List<IBearer>)
crc -> crc : Check valid registration
crc -> crb : request logo
activate crb
crc <- crb : receive logo
deactivate crb
media <- crc : onLogo(ETag-String, StationLogo)
media <- crc : onComplete(CompleteStatus, expiryDate)
deactivate crc
@enduml